<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<!-- Must live in Info.plist — INFOPLIST_KEY_UIBackgroundModes was not merged into the built app. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- IMPORTANT: Do NOT also set NSAllowsLocalNetworking here.
		     When that key is present, iOS ignores NSAllowsArbitraryLoads,
		     and cleartext HTTP is blocked for hosts ATS does not treat as local. -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>MotoTripTracker needs local network access to upload rides to your Mac or home server while testing Cloud Sync.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_http._tcp</string>
	</array>
</dict>
</plist>
